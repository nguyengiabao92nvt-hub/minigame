<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Minigame Đoàn khoa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--c:#0a58ca;--c2:#0b3d91;--c3:#1d7af3;--bg:#eef4fd;--ok:#16a34a;--bad:#dc2626;--ink:#14213d}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;font-family:"Be Vietnam Pro",system-ui,sans-serif;color:var(--ink);min-height:100vh;display:flex;flex-direction:column;background:#fffccf linear-gradient(180deg,#53cdf4 0%,#8fdde9 30%,#cff0db 55%,#fffccf 72%,#fffccf 100%)}
.hero{color:var(--c2);text-align:center;padding:26px 16px 22px}
.org{display:inline-block;font-size:12px;font-weight:800;letter-spacing:.14em;background:#ffffffd9;color:var(--c2);padding:5px 14px;border-radius:999px}
.logos{display:inline-block;background:#fff;border-radius:18px;padding:8px 16px;margin-bottom:12px;position:relative;box-shadow:0 6px 16px #0a2a6b44}
.logos img{display:block;height:68px;width:auto;max-width:100%}
.hero h1{font-size:clamp(27px,7.4vw,38px);font-weight:800;margin:14px 0 10px;line-height:1.2;color:#fff;text-shadow:-2px -2px 0 #0b3d91,2px -2px 0 #0b3d91,-2px 2px 0 #0b3d91,2px 2px 0 #0b3d91,0px -2px 0 #0b3d91,0px 2px 0 #0b3d91,-2px 0px 0 #0b3d91,2px 0px 0 #0b3d91,0 6px 12px #0b3d9166}
.sub{margin:0 auto;max-width:520px;font-size:15.5px;font-weight:600;line-height:1.5;color:#0b3d91;text-shadow:0 1px 0 #ffffff99}
.wrap{width:100%;max-width:560px;margin:0 auto;padding:0 14px 28px;position:relative;flex:1}
.sky{display:block;width:100%;height:auto;margin-top:auto;pointer-events:none}
h2{font-size:18px;margin:0 0 2px}
.card{background:#fff;border-radius:20px;padding:20px;box-shadow:0 10px 30px #0a3d9122}
label{display:block;font-size:14px;font-weight:600;margin:14px 0 5px;color:#334155}
input,textarea{width:100%;padding:12px 14px;border:1.5px solid #d5e0f2;border-radius:12px;font-size:16px;font-family:inherit;background:#f8fbff;transition:.15s}
input:focus,textarea:focus{outline:0;border-color:var(--c3);background:#fff;box-shadow:0 0 0 4px #1d7af326}
textarea{min-height:170px}
input[type=checkbox]{width:auto;margin-right:8px;accent-color:var(--c)}
button{width:100%;margin-top:14px;padding:14px;border:0;border-radius:14px;background:linear-gradient(135deg,var(--c),var(--c3));color:#fff;font-size:16px;font-weight:700;font-family:inherit;box-shadow:0 6px 16px #0a58ca44;transition:.15s}
button:active{transform:scale(.98)}
button.ghost{background:none;box-shadow:none;color:#64748b;font-size:13px;font-weight:600;margin-top:6px}
button.sec{background:#e8f0fd;color:var(--c2);box-shadow:none}button.red{background:#fee2e2;color:var(--bad);box-shadow:none}
button:disabled{opacity:.5}
.hide{display:none}
#bar{position:sticky;top:0;z-index:5;background:#fff;border-radius:16px;padding:10px 14px;margin-bottom:12px;box-shadow:0 6px 18px #0a3d9122}
.tr{display:flex;justify-content:space-between;align-items:center}
.tt{font-size:18px;font-weight:800;color:var(--c2)}.hint{font-size:12px;color:#64748b}
#tbar{height:8px;background:#e2ebfa;border-radius:99px;margin-top:8px;overflow:hidden}
#tfill{display:block;height:100%;width:100%;background:linear-gradient(90deg,var(--c),var(--c3));border-radius:99px;transition:width 1s linear}
.low #tfill{background:var(--bad)}.low .tt{color:var(--bad)}
.pool{min-height:60px;display:flex;flex-wrap:wrap;gap:8px;padding:12px;background:#dbe8fb;border:2px dashed #9dbbea;border-radius:16px;margin-bottom:14px}
.chip{padding:11px 18px;background:linear-gradient(135deg,var(--c),var(--c3));color:#fff;border-radius:999px;touch-action:none;user-select:none;-webkit-user-select:none;font-weight:700;font-size:18px;cursor:grab;box-shadow:0 4px 10px #0a58ca44}
.chip.sel{outline:3px solid #ffc828;outline-offset:2px}
.row{display:flex;align-items:center;gap:10px;margin-bottom:10px;background:#fff;border-radius:16px;padding:10px 12px;box-shadow:0 3px 10px #0a3d9114}
.def{flex:1;font-size:16.5px;font-weight:600;line-height:1.4}
.slot{flex:none;width:34%;min-width:112px;max-width:150px;min-height:58px;border:2px dashed #a8bfe3;border-radius:12px;display:flex;align-items:center;justify-content:center;padding:4px;background:#f3f8ff;transition:.15s}
.slot.over{border-color:var(--c3);background:#dcebff;transform:scale(1.03)}
.slot.ok{border:2px solid var(--ok);background:#dcfce7}
.slot.bad{border:2px solid var(--bad);background:#fee2e2}
#ghost{position:fixed;pointer-events:none;z-index:9;opacity:.92;transform:rotate(-3deg) scale(1.08)}
.msg{color:var(--bad);font-size:13.5px;margin-top:8px;min-height:18px}
.trophy{font-size:56px;text-align:center}
.big{font-size:46px;text-align:center;font-weight:800;color:var(--c)}
.hl{text-align:center;font-weight:700;color:var(--c2);margin-top:2px}
small{color:#64748b}
.instr{white-space:pre-line;background:#eef5ff;border-left:4px solid var(--c3);border-radius:10px;padding:10px 12px;margin-top:12px;font-size:14.5px;line-height:1.55;color:#1e3a6e}
.rule{background:#fff7d6;border-left-color:#f5b800;color:#6b4a00;white-space:normal;font-weight:600}
.tabs{display:flex;gap:8px;margin:12px 0}
.tab{background:#e8f0fd;color:var(--c2);box-shadow:none;margin:0;padding:10px;font-size:14px}
.tab.on{background:linear-gradient(135deg,var(--c),var(--c3));color:#fff;box-shadow:0 4px 12px #0a58ca44}
.lb{display:flex;align-items:center;gap:10px;background:#f4f8ff;border-radius:14px;padding:10px 12px;margin-bottom:8px}
.rk{width:32px;text-align:center;font-weight:800;font-size:18px}
.who{flex:1;min-width:0;overflow-wrap:anywhere}.who b{display:block;font-size:14.5px}
.sc{text-align:right;font-weight:800;color:var(--c);white-space:nowrap}.sc small{display:block;font-weight:400}
.bar{height:8px;background:#dbe8fb;border-radius:99px;margin-top:6px;overflow:hidden}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--c),var(--c3));border-radius:99px}
.empty{text-align:center;color:#64748b;padding:18px 0}
label small{font-weight:400}
.part{margin-bottom:20px}
.ptitle{background:linear-gradient(135deg,var(--c2),var(--c3));color:#fff;border-radius:14px;padding:14px 16px;font-weight:800;font-size:19px;line-height:1.35;margin-bottom:10px;box-shadow:0 6px 16px #0a3d9133}
#nav{display:flex;gap:10px;align-items:center;margin-top:14px}
#nav button{margin:0;flex:1}
#pg{font-weight:800;color:var(--c2);white-space:nowrap;font-size:15px}
.lt{display:block;font-size:13px;font-weight:600;opacity:.92;margin-top:3px}
</style></head><body>
<header class="hero" id="hero"><div class="logos"><img alt="Logo Đoàn TNCS Hồ Chí Minh, Đại học Sài Gòn, Hội Sinh viên Việt Nam" src="data:image/png;base64,"></div><br><div class="org" id="org"></div><h1 id="title"></h1><p class="sub" id="sub"></p></header>
<div class="wrap">


<!-- Sinh viên: nhập thông tin -->
<div id="s-form" class="card">
  <h2>Thông tin người tham gia</h2><small>Vui lòng điền chính xác để BTC ghi nhận kết quả.</small>
  <div class="instr" id="instr"></div>
  <div class="instr rule" id="rule"></div>
  <label>MSSV <small>(VD: 3124130001)</small></label><input id="mssv" inputmode="numeric" autocomplete="off" placeholder="3124130001">
  <label>Họ và tên <small>(VD: Nguyễn Văn A)</small></label><input id="name" autocomplete="off" placeholder="Nguyễn Văn A">
  <label>Chi đoàn <small>(VD: DSA1231)</small></label><input id="cls" autocomplete="off" placeholder="DSA1231">
  <label>Số điện thoại <small>(VD: 0123456789)</small></label><input id="phone" inputmode="tel" autocomplete="off" placeholder="0123456789">
  <label>Email <small>(VD: abc123@gmail.com)</small></label><input id="email" type="email" inputmode="email" autocomplete="off" placeholder="abc123@gmail.com">
  <div class="msg" id="err"></div>
  <button id="go" onclick="start()">Bắt đầu chơi →</button>
  <button class="sec" onclick="openBoard('form')">🏆 Bảng xếp hạng</button>
  <button class="ghost" onclick="show('admin')">Dành cho BTC</button>
</div>

<!-- Sinh viên: chơi -->
<div id="s-game" class="hide">
  <div id="bar"><div class="tr"><span class="tt">⏱ <span id="time"></span></span><span class="hint">Kéo (hoặc chạm) thẻ vào ô đúng</span></div><div id="tbar"><i id="tfill"></i></div></div>
  <div id="parts"></div>
  <div id="nav"><button class="sec" id="prev" onclick="go(-1)">← Trước</button><span id="pg"></span><button id="next" onclick="go(1)">Tiếp →</button></div>
  <button id="submit" class="hide" onclick="submit(false)">Nộp bài</button>
</div>

<!-- Sinh viên: kết quả -->
<div id="s-done" class="hide card">
  <div class="trophy" id="troph">🏆</div><div class="big" id="score"></div><div class="hl" id="hl"></div>
  <p id="res" style="text-align:center"></p>
  <button id="retry" class="hide" onclick="send()">Gửi lại kết quả</button>
  <button class="sec" onclick="openBoard('done')">🏆 Xem bảng xếp hạng</button>
</div>

<!-- Bảng xếp hạng -->
<div id="s-board" class="hide card">
  <h2>🏆 Bảng xếp hạng</h2>
  <small id="bnote"></small>
  <div class="tabs"><button class="tab on" id="t1" onclick="tab(1)">Cá nhân</button><button class="tab" id="t2" onclick="tab(2)">Chi đoàn</button></div>
  <div id="b1"></div><div id="b2" class="hide"></div>
  <button class="ghost" onclick="show(boardBack)">← Quay lại</button>
</div>

<!-- BTC -->
<div id="s-admin" class="hide card">
  <div id="a-login">
    <h2>Trang Ban tổ chức</h2>
    <label>Mật khẩu</label><input id="pw" type="password">
    <div class="msg" id="aerr"></div>
    <button onclick="login()">Đăng nhập</button>
    <button class="ghost" onclick="show('form')">← Về trang sinh viên</button>
  </div>
  <div id="a-panel" class="hide">
    <h2>Cài đặt trò chơi</h2>
    <label>Tên Đoàn - Hội (dòng nhãn trên cùng)</label><input id="a-org">
    <label>Tên minigame</label><input id="a-title">
    <label>Dòng mô tả dưới tên minigame</label><textarea id="a-sub" style="min-height:80px"></textarea>
    <label>Thời gian chơi (giây)</label><input id="dur" type="number" min="10">
    <label>Số câu đúng tối thiểu để được tính là đạt</label><input id="a-pass" type="number" min="1">
    <label><input id="open" type="checkbox">Đang mở cho sinh viên chơi</label>
    <label>Câu hỏi: mỗi dòng một cặp <b>thẻ | mô tả</b>. Dòng bắt đầu bằng <b>#</b> là tên một phần (VD: # Phần 1: ...)</label>
    <textarea id="qs" style="min-height:300px" placeholder="Hà Nội | Thủ đô của Việt Nam"></textarea>
    <label>Hướng dẫn hiển thị cho sinh viên</label><textarea id="ins" style="min-height:110px"></textarea>
    <div class="msg" id="aerr2" style="color:var(--ok)"></div>
    <button onclick="save()">Lưu cài đặt</button>
    <h2 style="margin-top:20px">Danh sách tham gia</h2>
    <small id="cnt"></small>
    <button class="sec" onclick="openBoard('admin')">🏆 Xem bảng xếp hạng và thống kê Chi đoàn</button>
    <button class="sec" onclick="dl()">Tải danh sách (CSV, mở bằng Excel)</button>
    <button class="sec" onclick="refresh()">Làm mới số liệu</button>
    <button class="red" onclick="reset()">Xóa toàn bộ kết quả</button>
    <button class="ghost" onclick="show('form')">← Về trang sinh viên</button>
  </div>
</div>
</div>

