    res.push([p.mssv, p.name, p.cls, p.phone, new Date().toISOString(), "", "", "", p.email || ""]); S("res2", res);
    return {ok: true, duration: cfg.duration, pairs: cfg.pairs, passScore: ps};
  }
  if (p.action === "submit") {
    const x = res.find(r => r[0] === p.mssv); if (!x) return {ok: false, msg: "Không tìm thấy lượt chơi."};
    x[5] = new Date().toISOString(); x[6] = Math.round((new Date(x[5]) - new Date(x[4])) / 1000); x[7] = Number(p.score);
    S("res2", res); return {ok: true, sec: x[6]};
  }
  if (p.pw !== "doankhoa123") return {ok: false, msg: "Sai mật khẩu."};
  if (p.action === "admin_get") return {ok: true, duration: cfg.duration, open: cfg.open, pairs: cfg.pairs, instruction: cfg.instruction, org: cfg.org, title: cfg.title, sub: cfg.sub, passScore: ps, results: res};
  if (p.action === "admin_save") { S("cfg2", {duration: p.duration || 60, open: p.open, pairs: p.pairs, instruction: p.instruction, org: p.org, title: p.title, sub: p.sub, passScore: p.passScore}); return {ok: true}; }
  if (p.action === "admin_reset") { S("res2", []); return {ok: true}; }
  return {ok: false, msg: "Yêu cầu không hợp lệ."};
}
const api = p => DEMO ? Promise.resolve(demo(p)) : fetch(API + "?" + new URLSearchParams(p)).then(r => r.json());
const post = b => DEMO ? Promise.resolve(demo(b)) : fetch(API, {method: "POST", body: JSON.stringify(b)}).then(r => r.json());
if (DEMO) document.querySelector(".wrap").insertAdjacentHTML("afterbegin",
  '<div style="background:#fef3c7;border-radius:10px;padding:8px 12px;font-size:13px;margin-bottom:12px">Bản xem thử: dữ liệu chỉ lưu trên máy đang mở. Mật khẩu BTC: <b>doankhoa123</b></div>');
const err = m => $("err").textContent = m;
const show = id => ["form","game","done","board","admin"].forEach(x => $("s-" + x).classList.toggle("hide", x !== id));
const shuffle = a => a.map(v => [Math.random(), v]).sort((x, y) => x[0] - y[0]).map(x => x[1]);
if (location.hash === "#admin") show("admin");
const applyText = r => {
  if (r.org) $("org").textContent = r.org;
  if (r.title) $("title").textContent = r.title;
  if (r.sub) $("sub").textContent = r.sub;
  document.title = ($("org").textContent + " · " + $("title").textContent);
};
const esc = s => String(s).replace(/[&<>"]/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"}[c]));
const showRule = () => $("rule").textContent = nQ ? "🎯 Đạt từ " + passScore + "/" + nQ + " câu đúng mới được tính vào bảng xếp hạng và điểm của Chi đoàn." : "";
const showInstr = t => $("instr").textContent = t || DEF_INSTR;
showInstr();
api({action: "config"}).then(r => {
  if (r && r.ok) { showInstr(r.instruction); applyText(r); passScore = r.passScore || 18; nQ = r.n || 0; showRule(); if (r.open === false) { err("Minigame hiện đang đóng."); $("go").disabled = true; } }
}).catch(() => {});

/* ================= SINH VIÊN ================= */
async function start() {
  const f = {mssv: $("mssv").value.trim(), name: $("name").value.trim(), cls: $("cls").value.trim().replace(/\s+/g, " ").toUpperCase(), phone: $("phone").value.trim(), email: $("email").value.trim().toLowerCase()};
  if (!f.mssv || !f.name || !f.cls || !/^0\d{9}$/.test(f.phone) || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.email)) return err("Vui lòng nhập đủ thông tin (SĐT gồm 10 số, email đúng định dạng).");
  $("go").disabled = true; err("Đang kiểm tra...");
  try {
    const r = await api({action: "start", ...f});
    if (!r.ok) { err(r.msg); $("go").disabled = false; return; }
    player = f; duration = r.duration; PAIRS = r.pairs; passScore = r.passScore || passScore; build(); show("game"); tick();
  } catch (e) { err("Lỗi kết nối, thử lại nhé."); $("go").disabled = false; }
}

let pages = [], cur = 0;
function build() {
  const titles = [...new Set(PAIRS.map(p => p[2] || ""))];
  $("parts").innerHTML = ""; pages = []; cur = 0;
  titles.forEach(t => {
    const all = PAIRS.map((_, i) => i).filter(i => (PAIRS[i][2] || "") === t);
    const n = Math.ceil(all.length / PAGE), size = Math.ceil(all.length / n);
    for (let k = 0; k < n; k++) {
      const ids = all.slice(k * size, (k + 1) * size), pi = pages.length;
      const box = document.createElement("div"); box.className = "part";
      const h = document.createElement("div"); h.className = "ptitle"; h.textContent = t || "Câu hỏi ghép đôi";
      if (n > 1) { const lt = document.createElement("span"); lt.className = "lt"; lt.textContent = "Lượt " + (k + 1) + "/" + n + " · " + ids.length + " câu"; h.appendChild(lt); }
      box.appendChild(h);
      const pool = document.createElement("div"); pool.className = "pool"; pool.dataset.part = pi;
      pool.onclick = e => { if (sel && e.target === pool) place(sel, pool); };
      box.appendChild(pool);
      shuffle(ids).forEach(i => {
        const c = document.createElement("div");
        c.className = "chip"; c.textContent = PAIRS[i][0]; c.dataset.id = i; c.dataset.part = pi; c.onpointerdown = down;
        pool.appendChild(c);
      });
      shuffle(ids).forEach(i => {
        const r = document.createElement("div"); r.className = "row";
        r.innerHTML = '<div class="slot" data-id="' + i + '" data-part="' + pi + '"></div><div class="def"></div>';
        r.lastChild.textContent = PAIRS[i][1];
        const sl = r.firstChild;
        sl.onclick = e => { const ch = e.target.closest(".chip"); if (sel && sel !== ch) place(sel, sl); };
        box.appendChild(r);
      });
      $("parts").appendChild(box); pages.push(box);
    }
  });
  nav();
}
function nav() {
  pages.forEach((b, i) => b.classList.toggle("hide", i !== cur));
  const last = cur === pages.length - 1;
  $("pg").textContent = "Trang " + (cur + 1) + "/" + pages.length;
  $("prev").disabled = cur === 0;
  $("next").classList.toggle("hide", last);
  $("submit").classList.toggle("hide", !last);
}
function go(d) {
  if (sel) { sel.classList.remove("sel"); sel = null; }
  cur = Math.max(0, Math.min(pages.length - 1, cur + d)); nav(); window.scrollTo({top: 0, behavior: "smooth"});
}

function tick() {
  left = duration; render();
  timer = setInterval(() => { left--; render(); if (left <= 0) submit(true); }, 1000);
}
const render = () => { const l = Math.max(left, 0); $("time").textContent = Math.floor(l / 60) + ":" + String(l % 60).padStart(2, "0");
  $("tfill").style.width = (l / duration * 100) + "%"; $("s-game").classList.toggle("low", l <= 10); };

function down(e) {
  if (finished) return;
  const c = e.currentTarget;
  drag = {c, x: e.clientX, y: e.clientY, moved: false, g: null};
  c.setPointerCapture(e.pointerId);
  c.onpointermove = move; c.onpointerup = up;
}
function target(e) {
  const el = document.elementFromPoint(e.clientX, e.clientY);
  return el && el.closest(".slot,.pool");
}
function move(e) {
  if (!drag) return;
  if (!drag.moved) {
    if (Math.hypot(e.clientX - drag.x, e.clientY - drag.y) < 8) return;
    drag.moved = true;
    const g = drag.c.cloneNode(true); g.id = "ghost"; document.body.appendChild(g);
    drag.g = g; drag.c.style.opacity = .3;
  }
  drag.g.style.left = e.clientX - 30 + "px"; drag.g.style.top = e.clientY - 22 + "px";
  if (e.clientY < 80) window.scrollBy(0, -14); else if (e.clientY > innerHeight - 80) window.scrollBy(0, 14);
  document.querySelectorAll(".slot.over").forEach(s => s.classList.remove("over"));
  const t = target(e); if (t && t.classList.contains("slot")) t.classList.add("over");
}
function up(e) {
  const d = drag; drag = null; d.c.onpointermove = d.c.onpointerup = null;
  document.querySelectorAll(".slot.over").forEach(s => s.classList.remove("over"));
  if (d.moved) {
    d.g.remove(); d.c.style.opacity = 1;
    const t = target(e); if (t) place(d.c, t);
  } else {
    if (sel) sel.classList.remove("sel");
    sel = sel === d.c ? null : d.c;
    if (sel) sel.classList.add("sel");
  }
}
function place(c, t) {
  if (finished || t.dataset.part !== c.dataset.part) return;   // chỉ thả trong cùng một phần
  if (sel) { sel.classList.remove("sel"); sel = null; }
  if (!t.classList.contains("pool")) {
    const old = t.firstElementChild;
    if (old && old !== c) document.querySelector('.pool[data-part="' + c.dataset.part + '"]').appendChild(old);
  }
  t.appendChild(c);
}

function submit(auto) {
  if (finished) return;
  const left0 = document.querySelectorAll(".pool .chip").length;
  if (!auto && left0 && !confirm("Còn " + left0 + " thẻ chưa đặt vào ô. Bạn vẫn muốn nộp bài?")) return;
  finished = true; clearInterval(timer); score = 0;
  document.querySelectorAll(".slot").forEach(s => {
    const c = s.firstElementChild;
    if (c && c.textContent === PAIRS[+s.dataset.id][0]) score++;   // so theo chữ: các thẻ trùng chữ (VD: 100%) dùng thay nhau được
  });
  show("done");
  $("score").textContent = score + "/" + PAIRS.length;
  const pass = score >= passScore;
  $("troph").textContent = pass ? "🏆" : "💪";
  $("hl").textContent = pass ? "Chúc mừng! Bạn đạt yêu cầu và được tính vào bảng xếp hạng 🎉" : "Bạn chưa đạt yêu cầu (cần từ " + passScore + "/" + PAIRS.length + " câu đúng).";
  $("res").textContent = auto ? "Hết giờ! Đang gửi kết quả..." : "Đang gửi kết quả...";
  send();
}
async function send() {
  $("retry").classList.add("hide");
  try {
    const r = await api({action: "submit", mssv: player.mssv, score});
    $("res").textContent = r.ok ? "Đã ghi nhận! Thời gian hoàn thành: " + r.sec + " giây. Cảm ơn bạn đã tham gia 🎉" : r.msg;
  } catch (e) {
    $("res").textContent = "Chưa gửi được kết quả, kiểm tra mạng rồi bấm Gửi lại.";
    $("retry").classList.remove("hide");
  }
}

/* ================= BẢNG XẾP HẠNG ================= */
function tab(n) {
  $("b1").classList.toggle("hide", n !== 1); $("b2").classList.toggle("hide", n !== 2);
  $("t1").classList.toggle("on", n === 1); $("t2").classList.toggle("on", n === 2);
}
async function openBoard(from) {
  boardBack = from; show("board"); tab(1);
  $("bnote").textContent = ""; $("b1").textContent = "Đang tải..."; $("b2").textContent = "";
  try { drawBoard(await api({action: "leaderboard"})); } catch (e) { $("b1").textContent = "Không tải được, thử lại sau nhé."; }
}
function drawBoard(r) {
  const m = ["🥇", "🥈", "🥉"];
  $("bnote").textContent = "Chỉ tính người đạt từ " + r.passScore + "/" + r.n + " câu đúng · " + r.passed + " người đạt trên " + r.total + " lượt tham gia";
  $("b1").innerHTML = r.players.length ? r.players.map((p, i) =>
    '<div class="lb"><span class="rk">' + (m[i] || i + 1) + '</span><div class="who"><b>' + esc(p.name) + '</b><small>' + esc(p.cls) + '</small></div><div class="sc">' + p.score + '/' + r.n + '<small>' + p.sec + ' giây</small></div></div>').join("")
    : '<p class="empty">Chưa có ai đạt yêu cầu.</p>';
  const mx = r.classes.length ? r.classes[0].count : 1;
  $("b2").innerHTML = r.classes.length ? r.classes.map((c, i) =>
    '<div class="lb"><span class="rk">' + (m[i] || i + 1) + '</span><div class="who"><b>' + esc(c.name) + '</b><div class="bar"><i style="width:' + (c.count / mx * 100) + '%"></i></div></div><div class="sc">' + c.count + '<small>người đạt</small></div></div>').join("")
    : '<p class="empty">Chưa có Chi đoàn nào có người đạt.</p>';
}

/* ================= BAN TỔ CHỨC ================= */
async function login() {
  pw = $("pw").value; $("aerr").textContent = "Đang đăng nhập...";
  try {
    const r = await post({action: "admin_get", pw});
    if (!r.ok) { $("aerr").textContent = r.msg; return; }
    adm = r; fill();
    $("a-login").classList.add("hide"); $("a-panel").classList.remove("hide");
  } catch (e) { $("aerr").textContent = "Lỗi kết nối."; }
}
function fill() {
  $("a-pass").value = adm.passScore || 18; $("a-org").value = adm.org || ORG; $("a-title").value = adm.title || TITLE; $("a-sub").value = adm.sub || SUB; $("ins").value = adm.instruction || DEF_INSTR; $("dur").value = adm.duration; $("open").checked = adm.open;
  let last = null;
  $("qs").value = adm.pairs.map(p => { const pt = p[2] || ""; let h = ""; if (pt !== last) { last = pt; if (pt) h = "# " + pt + "\n"; } return h + p[0] + " | " + p[1]; }).join("\n");
  $("cnt").textContent = "Có " + adm.results.length + " lượt tham gia, " + adm.results.filter(x => x[5] !== "").length + " người đã nộp bài.";
}
async function refresh() {
  try { const r = await post({action: "admin_get", pw}); if (r.ok) { adm = r; $("cnt").textContent = ""; fill(); } } catch (e) {}
}
async function save() {
  const pairs = []; let part = "";
  $("qs").value.split("\n").forEach(l => {
    l = l.trim();
    if (l[0] === "#") { part = l.replace(/^#+\s*/, ""); return; }
    const a = l.split("|").map(x => x.trim());
    if (a.length >= 2 && a[0] && a[1]) pairs.push([a[0], a.slice(1).join("|"), part]);
  });
  const m = $("aerr2");
  if (pairs.length < 2) { m.style.color = "var(--bad)"; m.textContent = "Cần ít nhất 2 cặp (mỗi dòng: thẻ | mô tả)."; return; }
  m.textContent = "Đang lưu...";
  try {
    const r = await post({action: "admin_save", pw, duration: +$("dur").value, open: $("open").checked, pairs, instruction: $("ins").value, org: $("a-org").value, title: $("a-title").value, sub: $("a-sub").value, passScore: +$("a-pass").value || 18});
    const ps = +$("a-pass").value || 18, warn = pairs.length < ps;
    m.style.color = r.ok && !warn ? "var(--ok)" : "var(--bad)";
    m.textContent = r.ok ? (warn ? "Đã lưu, nhưng chỉ có " + pairs.length + " câu, ít hơn mức đạt " + ps + " nên sẽ không ai đạt được." : "Đã lưu ✔") : r.msg;
  } catch (e) { m.style.color = "var(--bad)"; m.textContent = "Lỗi kết nối."; }
}
async function dl() {
  await refresh();
  const q = v => '"' + String(v).replace(/"/g, '""') + '"', t = v => '="' + v + '"';
  const f = v => v ? new Date(v).toLocaleString("vi-VN") : "";
  const rows = adm.results.slice().sort((a, b) => (a[5] === "") - (b[5] === "") || b[7] - a[7] || a[6] - b[6]);
  const head = ["STT","MSSV","Họ tên","Chi đoàn","SĐT","Email","Bắt đầu","Nộp lúc","Thời gian (giây)","Điểm","Kết quả"];
  const lines = [head.map(q).join(",")].concat(rows.map((r, i) =>
    [i + 1, t(r[0]), q(r[1]), q(r[2]), t(r[3]), q(r[8] || ""), q(f(r[4])), q(f(r[5])), r[6], r[7], q(r[5] === "" ? "Chưa nộp" : r[7] >= (adm.passScore || 18) ? "Đạt" : "Chưa đạt")].join(",")));
  const data = "\ufeff" + lines.join("\r\n"), name = "danh-sach-tham-gia.csv";
  try {
    const d = window.claude && await claude.use("downloads");
    if (d) { await d.save({filename: name, data}); return; }
  } catch (e) { return; }
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([data], {type: "text/csv"}));
  a.download = name; a.click();
}
async function reset() {
  if (!confirm("Xóa toàn bộ kết quả đã ghi? Không hoàn tác được.")) return;
  await post({action: "admin_reset", pw}); refresh();
}
