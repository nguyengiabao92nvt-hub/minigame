const DEF_INSTR = "1. Điền đầy đủ thông tin rồi bấm Bắt đầu chơi, đồng hồ sẽ chạy ngay.\n2. Kéo (hoặc chạm) thẻ xanh vào ô mô tả đúng.\n3. Bấm Nộp bài khi xong; hết giờ hệ thống tự nộp.\n4. Mỗi MSSV chỉ được tham gia 1 lần.";
/* ====================== */

const PAGE = 5;   // số cặp hiển thị trên mỗi trang (đặt 10 để hiện cả một phần trên một trang)
const $ = id => document.getElementById(id);
$("title").textContent = TITLE; $("org").textContent = ORG; $("sub").textContent = SUB; document.title = ORG + " · " + TITLE;
let PAIRS = [], player = {}, duration = 120, left = 0, timer = null, finished = false, sel = null, drag = null, score = 0;
let pw = "", adm = null, passScore = 18, nQ = 0, boardBack = "form";

/* Chế độ XEM THỬ: khi chưa dán địa chỉ Google Sheet, dữ liệu chỉ lưu trên chính máy đang mở */
const DEMO = API.indexOf("DÁN") === 0;
const L = (k, d) => { try { const v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; } catch (e) { return d; } };
const S = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };
const SAMPLE = [["750", "Dự án khởi nghiệp đổi mới sáng tạo được hỗ trợ đầu ra", "Phần 1: Tìm hiểu Nội dung trọng tâm của Nghị quyết Đại hội đại biểu toàn quốc Đoàn TNCS Hồ Chí Minh lần thứ XIII"], ["4 triệu", "Thiếu nhi có hoàn cảnh khó khăn được tổ chức Đoàn, Hội, Đội hỗ trợ", "Phần 1: Tìm hiểu Nội dung trọng tâm của Nghị quyết Đại hội đại biểu toàn quốc Đoàn TNCS Hồ Chí Minh lần thứ XIII"], ["100 triệu", "Đoàn viên, thanh niên tham gia hoạt động tình nguyện", "Phần 1: Tìm hiểu Nội dung trọng tâm của Nghị quyết Đại hội đại biểu toàn quốc Đoàn TNCS Hồ Chí Minh lần thứ XIII"], ["50%", "Đoàn viên xếp loại hoàn thành xuất sắc nhiệm vụ", "Phần 1: Tìm hiểu Nội dung trọng tâm của Nghị quyết Đại hội đại biểu toàn quốc Đoàn TNCS Hồ Chí Minh lần thứ XIII"], ["80%", "Thanh thiếu nhi tham gia hoạt động nâng cao năng lực số, sử dụng khoa học công nghệ", "Phần 1: Tìm hiểu Nội dung trọng tâm của Nghị quyết Đại hội đại biểu toàn quốc Đoàn TNCS Hồ Chí Minh lần thứ XIII"], ["1 triệu", "Đoàn viên ưu tú được giới thiệu cho Đảng xem xét kết nạp", "Phần 1: Tìm hiểu Nội dung trọng tâm của Nghị quyết Đại hội đại biểu toàn quốc Đoàn TNCS Hồ Chí Minh lần thứ XIII"], ["100.000", "Công trình thanh niên về khoa học công nghệ, đổi mới sáng tạo, chuyển đổi số", "Phần 1: Tìm hiểu Nội dung trọng tâm của Nghị quyết Đại hội đại biểu toàn quốc Đoàn TNCS Hồ Chí Minh lần thứ XIII"], ["10 triệu", "Thanh thiếu nhi tham gia chương trình bồi dưỡng ngoại ngữ, hội nhập", "Phần 1: Tìm hiểu Nội dung trọng tâm của Nghị quyết Đại hội đại biểu toàn quốc Đoàn TNCS Hồ Chí Minh lần thứ XIII"], ["100%", "Thông tin đoàn viên, cán bộ đoàn được số hóa hằng năm", "Phần 1: Tìm hiểu Nội dung trọng tâm của Nghị quyết Đại hội đại biểu toàn quốc Đoàn TNCS Hồ Chí Minh lần thứ XIII"], ["100%", "Đoàn xã, phường, đặc khu xóa ít nhất 01 điểm đen về ô nhiễm môi trường, đồng thời duy trì bền vững kết quả đã đạt được", "Phần 1: Tìm hiểu Nội dung trọng tâm của Nghị quyết Đại hội đại biểu toàn quốc Đoàn TNCS Hồ Chí Minh lần thứ XIII"], ["500.000", "Số thanh niên tham gia các chương trình trao đổi quốc tế, giao lưu học thuật, hợp tác khởi nghiệp và tình nguyện quốc tế", "Phần 2: Tìm hiểu Chiến lược phát triển thanh niên Việt Nam giai đoạn 2021 - 2030 của Thủ tướng Chính phủ"], ["40%", "Thanh niên có kỹ năng số nâng cao, kỹ năng ứng dụng trí tuệ nhân tạo (AI)", "Phần 2: Tìm hiểu Chiến lược phát triển thanh niên Việt Nam giai đoạn 2021 - 2030 của Thủ tướng Chính phủ"], ["80%", "Thanh niên được phổ cập kiến thức, kỹ năng số cơ bản", "Phần 2: Tìm hiểu Chiến lược phát triển thanh niên Việt Nam giai đoạn 2021 - 2030 của Thủ tướng Chính phủ"], ["15%", "Tăng số công trình khoa học và công nghệ do thanh niên chủ trì", "Phần 2: Tìm hiểu Chiến lược phát triển thanh niên Việt Nam giai đoạn 2021 - 2030 của Thủ tướng Chính phủ"], ["6%", "Tỷ lệ thanh niên thất nghiệp, thiếu việc làm", "Phần 2: Tìm hiểu Chiến lược phát triển thanh niên Việt Nam giai đoạn 2021 - 2030 của Thủ tướng Chính phủ"], ["70%", "Thanh niên tham gia hoạt động tình nguyện, hoạt động vì cộng đồng hằng năm", "Phần 2: Tìm hiểu Chiến lược phát triển thanh niên Việt Nam giai đoạn 2021 - 2030 của Thủ tướng Chính phủ"], ["30%", "Thanh niên có trình độ ngoại ngữ bậc 3 trở lên", "Phần 2: Tìm hiểu Chiến lược phát triển thanh niên Việt Nam giai đoạn 2021 - 2030 của Thủ tướng Chính phủ"], ["20%", "Thanh niên trong các cơ quan nhà nước, tổ chức chính trị - xã hội được đưa vào quy hoạch lãnh đạo", "Phần 2: Tìm hiểu Chiến lược phát triển thanh niên Việt Nam giai đoạn 2021 - 2030 của Thủ tướng Chính phủ"], ["50%", "Thanh niên tham gia và hoàn thành ít nhất 01 khóa học trực tuyến MOOCs", "Phần 2: Tìm hiểu Chiến lược phát triển thanh niên Việt Nam giai đoạn 2021 - 2030 của Thủ tướng Chính phủ"], ["90%", "Thanh niên được tư vấn hướng nghiệp và kỹ năng lựa chọn nghề nghiệp", "Phần 2: Tìm hiểu Chiến lược phát triển thanh niên Việt Nam giai đoạn 2021 - 2030 của Thủ tướng Chính phủ"]];
function boardOf(res, pass) {
  const ok = res.filter(x => x[5] !== "" && x[7] >= pass).sort((a, b) => b[7] - a[7] || a[6] - b[6]), by = {};
  ok.forEach(x => by[x[2]] = (by[x[2]] || 0) + 1);
  const classes = Object.keys(by).map(k => ({name: k, count: by[k]})).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
  return {total: res.length, passed: ok.length, players: ok.slice(0, 50).map(x => ({name: x[1], cls: x[2], score: x[7], sec: x[6]})), classes};
}
function demo(p) {
  const cfg = L("cfg2", {duration: 600, open: true, pairs: SAMPLE}), res = L("res2", []), ps = cfg.passScore || 18;
  if (p.action === "config") return {ok: true, open: cfg.open, instruction: cfg.instruction, org: cfg.org, title: cfg.title, sub: cfg.sub, passScore: ps, n: cfg.pairs.length};
  if (p.action === "leaderboard") return Object.assign({ok: true, passScore: ps, n: cfg.pairs.length}, boardOf(res, ps));
  if (p.action === "start") {
    if (!cfg.open) return {ok: false, msg: "Minigame hiện đang đóng."};
